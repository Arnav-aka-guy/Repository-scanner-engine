# ── LLM Providers (set at least one) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── System Design LLM Models ────────────────────────────────────────────────
# Groq model used only by the System Design feature (low reasoning, rate-limited)
SYSTEM_DESIGN_MODEL=openai/gpt-oss-120b
# OpenRouter fallback model used if Groq hits 429/413 quota limits
SYSTEM_DESIGN_FALLBACK_MODEL=openai/gpt-oss-120b:free

# ── LLM Defaults ────────────────────────────────────────────────────────────
LLM_PROVIDER=auto
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
# Optional context budget in characters (default: 12000 for Groq, 32000 for others)
# LLM_CONTEXT_CHAR_BUDGET=12000

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Database ─────────────────────────────────────────────────────────────────
# Set DATABASE_ENABLED=true to persist repositories, chat history, and scan
# records in PostgreSQL.  Leave false (default) to use filesystem-only storage.
DATABASE_ENABLED=false
# In production, specify your secure PostgreSQL credentials or use SQLite default:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL=sqlite+aiosqlite:///data/antigravity.db

# ── Authentication (optional) ─────────────────────────────────────────────
# Set AUTH_ENABLED=true in production. When enabled, JWT_SECRET_KEY MUST be
# a strong random secret (≥ 32 chars, not a known placeholder).
#
# Generate a secure secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
AUTH_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ADMIN_USERNAME=admin
# Generate hash with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  For production, restrict to your
# actual frontend domain (e.g. CORS_ORIGINS=["https://app.example.com"]).
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Scanning limits ───────────────────────────────────────────────────────────
# Increase these if you have very large repositories.
MAX_FILES=10000
MAX_FILE_SIZE_BYTES=5242880
MAX_DIRECTORY_DEPTH=30

# ── Allowed Repository Roots (Path Allowlist) ────────────────────────────────
# Restrict repository scanning and file exploration to specific base directories.
# Recommended for security: restrict to your projects directory (e.g. ~/projects).
# Comma-separated or JSON list. If empty, falls back to blocklist + home directory protection.
ALLOWED_ROOTS=~/projects

# ── Data ─────────────────────────────────────────────────────────────────────
DATA_DIR=data

# ── Hosting (only needed when other people use your server) ──────────────────
# Cap AI requests per user per day so one person cannot use up your free
# Groq/OpenRouter quota. 0 = no cap (right for the local app).
AI_DAILY_LIMIT_PER_USER=0

# Password reset emails. Leave SMTP_HOST empty to turn email off; users can
# then be reset by an admin with: python -m backend.scripts.manage_users reset-password
# Gmail works for free: create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# The address people open in their browser; used in reset links
PUBLIC_APP_URL=http://localhost:8000
