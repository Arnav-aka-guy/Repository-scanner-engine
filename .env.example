# ── LLM Providers (set at least one) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── LLM Defaults ────────────────────────────────────────────────────────────
LLM_PROVIDER=auto
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
# Optional context budget in characters (default: 12000 for Groq, 32000 for others)
# LLM_CONTEXT_CHAR_BUDGET=12000

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Database ─────────────────────────────────────────────────────────────────
# Set DATABASE_ENABLED=true to persist repositories, chat history, and scan
# records in PostgreSQL.  Leave false (default) to use filesystem-only storage.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/antigravity

# ── Authentication (optional) ─────────────────────────────────────────────
# Set AUTH_ENABLED=true in production.  When enabled, JWT_SECRET_KEY MUST be
# a strong random secret (≥ 32 chars, not a known placeholder).
#
# Generate a secure secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
AUTH_ENABLED=false
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ADMIN_USERNAME=admin
# Generate hash with: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  For production, restrict to your
# actual frontend domain (e.g. CORS_ORIGINS=["https://app.example.com"]).
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Scanning limits ───────────────────────────────────────────────────────────
# Increase these if you have very large repositories.
MAX_FILES=10000
MAX_FILE_SIZE_BYTES=5242880
MAX_DIRECTORY_DEPTH=30

# ── Allowed Repository Roots (Path Allowlist) ────────────────────────────────
# Restrict repository scanning and file exploration to specific base directories.
# Recommended for security: restrict to your projects directory (e.g. ~/projects).
# Comma-separated or JSON list. If empty, falls back to blocklist + home directory protection.
ALLOWED_ROOTS=~/projects

# ── Data ─────────────────────────────────────────────────────────────────────
DATA_DIR=data
